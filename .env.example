# Exemplo de variáveis de ambiente
# Ative a exibição do QR no CLI (1 = mostrar)
SHOW_WA_QR=1
# URL/ponto de integração do WhatsApp (padrão se não definido):
WA_INTEGRATION_URL=https://wa.me/557791307594
# Se quiser salvar o QR em arquivo (ex: qr.png) defina:
# SAVE_WA_QR_FILE=qr.png

# Venom (WhatsApp) integration example
# Set USE_VENOM=1 to enable venom-bot; ensure Chrome/Chromium is available
USE_VENOM=0
VENOM_DIR=venom-session
# If you need to explicitly set the Chrome executable, provide its path:
CHROME_PATH=
HEADLESS=1
# Additional puppeteer args (comma separated), e.g. "--no-sandbox,--disable-setuid-sandbox"
EXTRA_PUPPETER_ARGS=

# API / security
API_TOKEN=

# Bot settings
BOT_NAME=FarmaciaBot
PORT=3000
